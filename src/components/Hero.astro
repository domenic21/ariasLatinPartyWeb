---
/* ============================================================
   HERO  (first screen)
   Layout (desktop):  [ text on the LEFT ]   [ video of Edison on the RIGHT ]
   Layout (mobile):   video on top, text below.
   Background:        the ARIAS logo as a large faint watermark.

   Content comes from: src/data/site.ts -> `hero`
   Video:             /public/videos/ (hero.webm, hero.mp4, hero-poster.jpg)
   Logo watermark:    /public/images/logo.png
   ============================================================ */
import { getContent } from "../data/site";
const { hero } = getContent(Astro.currentLocale);
---

<section
  id="top"
  class="relative flex min-h-screen items-center overflow-hidden px-6 pt-28 pb-12 sm:pt-24"
>
  {/* ---- BACKGROUND LOGO WATERMARK ----
       Sits furthest back (-z-10), centered, faint and slightly blurred.
       Scales with the viewport (w-[90%] caps it on big screens). */}
  <img
    src="/images/logo.png"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-1/2 -z-10 w-[120%] max-w-[900px] -translate-x-1/2 -translate-y-1/2 opacity-[0.06] blur-[1px] sm:w-[80%]"
  />

  {/* ---- MAIN GRID ----
       1 column on mobile, 2 columns from `lg` (large screens) up. */}
  <div
    class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-8 lg:grid-cols-2"
  >
    {/* ===== LEFT: hero text ===== */}
    <div class="order-2 text-center lg:order-1 lg:text-left">
      {/* Headline. The badge ("Latin DJ in Houston, TX") is the first line
          of the <h1> so Google sees the main keyword + city in the page's
          top heading. The name lines below use the Nosifer display font;
          the middle line gets the neon-blue gradient. */}
      <h1 class="font-graffiti text-4xl leading-[1.35] sm:text-6xl xl:text-7xl">
        <span class="mb-4 block font-body text-xs font-semibold leading-normal tracking-[0.3em] text-neon-blue sm:text-sm">
          {hero.badge}
        </span>
        {
          hero.titleLines.map((line, i) => (
            <span class={`block ${i === 1 ? "text-gradient" : "text-white"}`}>
              {line}
            </span>
          ))
        }
      </h1>

      <p class="mx-auto mt-6 max-w-md text-sm text-white/70 sm:text-base lg:mx-0">
        {hero.subtitle}
      </p>

      {/* Buttons: centered on mobile, left-aligned on desktop */}
      <div class="mt-8 flex flex-wrap justify-center gap-4 lg:justify-start">
        <a
          href={hero.primaryCta.href}
          class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-ink transition hover:bg-white/90 sm:px-7"
        >
          {hero.primaryCta.label}
        </a>
        <a
          href={hero.secondaryCta.href}
          class="rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10 sm:px-7"
        >
          {hero.secondaryCta.label}
        </a>
      </div>
    </div>

    {/* ===== RIGHT: vertical clip of Edison playing =====
         The clip is vertical (9:16, shot for TikTok/Reels), so it sits in a
         tall rounded card. Behind it, a blurred + darkened copy of the poster
         fills the column so the vertical shape looks intentional on desktop.
         Files: public/videos/hero.webm|mp4 (~350 KB) + hero-poster.jpg, which
         shows instantly while the video loads (and stays if motion is reduced).
         Heights are capped so the headline + buttons stay visible on phones. */}
    <div class="order-1 lg:order-2">
      <div class="relative mx-auto flex h-[300px] items-center justify-center sm:h-[440px] lg:h-[600px]">
        {/* Blurred backdrop glow (desktop/tablet only) */}
        <div
          aria-hidden="true"
          class="absolute inset-y-6 left-1/2 hidden w-[110%] max-w-[560px] -translate-x-1/2 rounded-[3rem] bg-cover bg-center opacity-40 blur-3xl sm:block"
          style="background-image: url('/videos/hero-poster.jpg')"
        >
        </div>

        {/* The video card */}
        <div class="relative aspect-[9/16] h-full overflow-hidden rounded-3xl border border-white/10 shadow-2xl shadow-neon-blue/20">
          <video
            id="hero-video"
            class="h-full w-full object-cover"
            poster="/videos/hero-poster.jpg"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={hero.videoLabel}
          >
            <source src="/videos/hero.webm" type="video/webm" />
            <source src="/videos/hero.mp4" type="video/mp4" />
          </video>
          {/* Tint + bottom fade so the bright wall blends into the dark theme */}
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-neon-violet/20"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Respect "reduce motion": keep the still poster instead of the looping clip.
  (function () {
    const v = document.getElementById("hero-video");
    if (v && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      v.removeAttribute("autoplay");
      v.pause();
    }
  })();
</script>
